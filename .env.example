# MONGODB_URI: Your MongoDB Atlas connection string (SRV format)
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/freshway_pos?retryWrites=true&w=majority
MONGODB_URI=""

# AUTH_SECRET: 64-character secret key for signing HMAC-SHA256 Bearer tokens
# Leave blank locally to auto-generate in /data/.auth_secret, or set on Render
AUTH_SECRET=""

# ALLOWED_ORIGIN: Your Vercel Frontend URL (for CORS when deployed on Render)
# Example: https://freshway-water-pos.vercel.app
ALLOWED_ORIGIN="*"

# VITE_API_URL: Your Render Backend URL (set this in Vercel Environment Variables)
# Leave empty when running locally (npm run dev)
# Example: https://freshway-water-pos-api.onrender.com
VITE_API_URL=""

# GEMINI_API_KEY: Optional Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
